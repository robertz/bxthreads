/**
 * "N viewing now" presence — a heartbeat/TTL model, not lifecycle-event refcounting
 * (onSubscribe/onUnsubscribe/onClose refcounting drifts whenever any lifecycle event is missed —
 * reconnects, killed tabs, server restarts). Self-healing by construction: a session counts as
 * present only while its last ping is within PRESENCE_TTL_SECONDS.
 *
 * Ping transport is a real STOMP SEND frame (public/assets/js/realtime.js's sendPresencePing()/
 * sendPostPresencePing(), via client.publish()) on the same post./forum. destination the page
 * already subscribes to for broadcasts — ws/Stomp.bx's onSend() hook absorbs it (nothing gets
 * relayed to subscribers as a raw ping) and calls ping()/pingPost() below directly, which then
 * broadcasts the computed count back over that same destination. This used to be a REST POST
 * side-channel before boxExpressStomp() gained an onSend interception hook to absorb a client
 * SEND — see boxlang-express's own Stomp.bx docblock for that hook's absorb/transform/pass-through
 * contract.
 *
 * Three independent presence "channels" share the same TTL/prune mechanics: forums (`ping()`/
 * `count()`, broadcasting `forum-presence` on the `forum.{id}` destination — the original Phase 6
 * feature), posts (`pingPost()`/`countPost()`, broadcasting `post-presence` on the SAME
 * `post.{id}` destination the post-detail page already subscribes to for comment/vote broadcasts
 * — no new client subscription needed), and per-user online status (`pingUser()`/`isUserOnline()`/
 * `getOnlineUserIds()` — every identified visitor's client already subscribes to `user.{uid}` for
 * their own notification badge, so the heartbeat rides that same destination too; see
 * ws/Stomp.bx's onSend()). Unlike the other two, user presence has no broadcast: it's queried
 * server-side at render time (lib/FeedItemRenderer.bx, lib/CommentRenderer.bx) for an online dot
 * next to a poster's name, not pushed live to every open tab — see those files' own notes on that
 * scope decision. State: `{ "forum:{id}"|"post:{id}"|"user:{id}": { sessionKey:
 * lastSeenEpochSeconds } }`. Nothing else — no per-session bookkeeping to leak or drift.
 */
class {

	variables.PRESENCE_TTL_SECONDS = 75;

	function init( required any stomp ) {
		variables.stomp = arguments.stomp;
		variables.byChannel = {};
		variables.lockName = "Presence-" & createUUID();
		return this;
	}

	function ping( required string forumIdShort, required string sessionKey ) {
		return _ping( "forum:" & arguments.forumIdShort, arguments.sessionKey, "forum." & arguments.forumIdShort, "forum-presence" );
	}

	function count( required string forumIdShort ) {
		return _count( "forum:" & arguments.forumIdShort, "forum." & arguments.forumIdShort, "forum-presence" );
	}

	function pingPost( required string postIdShort, required string sessionKey ) {
		return _ping( "post:" & arguments.postIdShort, arguments.sessionKey, "post." & arguments.postIdShort, "post-presence" );
	}

	function countPost( required string postIdShort ) {
		return _count( "post:" & arguments.postIdShort, "post." & arguments.postIdShort, "post-presence" );
	}

	/** Stamps sessionKey present for uid. No broadcast — see class docblock. */
	function pingUser( required string uid, required string sessionKey ) {
		var channelKey = "user:" & arguments.uid;
		lock name="#variables.lockName#" type="exclusive" timeout="5" {
			if ( !structKeyExists( variables.byChannel, channelKey ) ) {
				variables.byChannel[ channelKey ] = {};
			}
			_prune( channelKey );
			variables.byChannel[ channelKey ][ arguments.sessionKey ] = _nowSeconds();
		}
	}

	/** True if uid has at least one un-expired ping (any tab/device counts). */
	function isUserOnline( required string uid ) {
		var channelKey = "user:" & arguments.uid;
		lock name="#variables.lockName#" type="exclusive" timeout="5" {
			if ( !structKeyExists( variables.byChannel, channelKey ) ) return false;
			return _prune( channelKey ) > 0;
		}
	}

	/**
	 * Batch form of isUserOnline() for a feed/comment tree with many distinct authors — one lock
	 * acquisition instead of one per row. Returns a uid-keyed struct; keyExists(uid) means online,
	 * a missing key means offline (not present in the returned struct at all, so callers can use
	 * plain keyExists() rather than checking a boolean value).
	 */
	function getOnlineUserIds( required array uids ) {
		var online = {};
		lock name="#variables.lockName#" type="exclusive" timeout="5" {
			for ( var uid in arguments.uids ) {
				var channelKey = "user:" & uid;
				if ( structKeyExists( variables.byChannel, channelKey ) && _prune( channelKey ) > 0 ) {
					online[ uid ] = true;
				}
			}
		}
		return online;
	}

	/**
	 * Stamps sessionKey present on channelKey, prunes expired entries, and broadcasts the new
	 * count to destination if the live set actually changed size (a joiner appeared, or stale
	 * sessions aged out in the same prune pass).
	 */
	private function _ping( required string channelKey, required string sessionKey, required string destination, required string event ) {
		var countBefore = -1;
		var countAfter = 0;
		lock name="#variables.lockName#" type="exclusive" timeout="5" {
			if ( !structKeyExists( variables.byChannel, arguments.channelKey ) ) {
				variables.byChannel[ arguments.channelKey ] = {};
			}
			countBefore = _prune( arguments.channelKey );
			variables.byChannel[ arguments.channelKey ][ arguments.sessionKey ] = _nowSeconds();
			countAfter = structCount( variables.byChannel[ arguments.channelKey ] );
		}
		if ( countAfter != countBefore ) {
			_broadcast( arguments.destination, arguments.event, countAfter );
		}
		return countAfter;
	}

	/**
	 * Prunes then counts. If the read itself is the first observer of an expiry, it broadcasts
	 * the corrected count — otherwise an HTTP-render-triggered prune would silently swallow the
	 * transition and already-connected viewers would keep seeing the stale value.
	 */
	private function _count( required string channelKey, required string destination, required string event ) {
		var countBefore = -1;
		var countAfter = 0;
		lock name="#variables.lockName#" type="exclusive" timeout="5" {
			if ( !structKeyExists( variables.byChannel, arguments.channelKey ) ) {
				return 0;
			}
			countBefore = structCount( variables.byChannel[ arguments.channelKey ] );
			countAfter = _prune( arguments.channelKey );
		}
		if ( countAfter != countBefore ) {
			_broadcast( arguments.destination, arguments.event, countAfter );
		}
		return countAfter;
	}

	/**
	 * Must be called under variables.lockName already held — removes expired sessionKeys for
	 * channelKey and returns the resulting count.
	 */
	private function _prune( required string channelKey ) {
		if ( !structKeyExists( variables.byChannel, arguments.channelKey ) ) return 0;
		var cutoff = _nowSeconds() - variables.PRESENCE_TTL_SECONDS;
		var sessions = variables.byChannel[ arguments.channelKey ];
		for ( var key in structCopy( sessions ) ) {
			if ( sessions[ key ] < cutoff ) structDelete( sessions, key );
		}
		return structCount( sessions );
	}

	private function _broadcast( required string destination, required string event, required numeric count ) {
		try {
			variables.stomp.send( arguments.destination, { event: arguments.event, count: arguments.count } );
		} catch ( any e ) {
			new "lib.AppContext"().get( "Logger" ).warn( "Presence broadcast failed for #arguments.destination#: #e.message#" );
		}
	}

	private function _nowSeconds() {
		return createObject( "java", "java.time.Instant" ).now().getEpochSecond();
	}

}
