/**
 * bxThreads entry point.
 * Start with: boxlang --bx-config ./boxlang.json app.bxs
 *
 * Phase 1 (foundation) only: DI registry, session/identity bootstrap, security headers, error
 * handling. Routing (Phase 3), the REST API (Phase 4), the interactive rewrite (Phase 5), and
 * the realtime layer (Phase 6) land in later phases — see .claude/plans/typed-seeking-frog.md.
 */

// Mitigates SSRF-via-DNS-rebinding in ImageProxyService/SpiderService's URL-safety checks: both
// resolve a hostname, validate every address is public, then hand the *same hostname string* to
// jsoup for the actual fetch — which re-resolves DNS independently. Without this, a malicious
// authoritative DNS server could answer the safety check's lookup with a public IP and jsoup's
// (moments-later) lookup with a private one (127.0.0.1, 169.254.169.254, etc.), bypassing the
// check entirely. Both lookups go through this same JVM-wide InetAddress cache, so pinning a
// short positive TTL here forces jsoup's connect() to reuse the exact answer the safety check
// already validated, closing the race — instead of requiring a bespoke resolve-then-connect-by-IP
// networking layer for every external fetch in the app.
createObject( "java", "java.security.Security" ).setProperty( "networkaddress.cache.ttl", "30" )
createObject( "java", "java.security.Security" ).setProperty( "networkaddress.cache.negative.ttl", "10" )

app = boxExpress()

Config     = new "lib.Config"()
AppContext = new "lib.AppContext"()
Session    = new "lib.Session"()

AppContext.register( "Config", Config )
AppContext.register( "Logger", new "lib.Logger"() )
AppContext.register( "Populate", new "lib.Populate"() )
AppContext.register( "Sql", new "lib.Sql"() )
AppContext.register( "Session", Session )
AppContext.register( "View", new "lib.View"() )
AppContext.register( "RequestContext", new "lib.RequestContext"() )
AppContext.register( "JsonAction", new "lib.JsonAction"() )

AppContext.scanDirectory( expandPath( "./models/beans" ), "models.beans" )
AppContext.scanDirectory( expandPath( "./models/dao" ), "models.dao" )
AppContext.scanDirectory( expandPath( "./models/services" ), "models.services" )

app.set( "env", Config.getEnv() )
app.set( "reloadOnChange", Config.getEnv() == "development" )
app.set( "views", expandPath( "./views" ) )

// Body parsers — login/signup are plain HTML form POSTs (urlencoded); JSON is for Phase 4's API.
app.use( boxExpressUrlencoded() )
app.use( boxExpressJSON() )

// Prefers the minified build (`npm run build`, see package.json / scripts/build-assets.mjs)
// when it's been run; falls back per-file to the raw /assets/... path otherwise (see
// views/layouts/Main.bxm's keyExists() checks and lib/RequestContext.bx's own note) — so a
// checkout that hasn't run the asset build still works.
app.locals.assets = {}
assetBuildCandidates = [
	{ src: "site.css",     min: "/assets/css/site.min.css" },
	{ src: "global.js",    min: "/assets/js/global.min.js" },
	{ src: "actions.js",   min: "/assets/js/actions.min.js" },
	{ src: "realtime.js",  min: "/assets/js/realtime.min.js" }
]
for ( pair in assetBuildCandidates ) {
	if ( fileExists( expandPath( "./public" & pair.min ) ) ) {
		app.locals.assets[ pair.src ] = pair.min
	}
}

/**
 * Security headers — direct port of handlers/Main.bx::onRequestStart(). Kept as one explicit
 * middleware (not boxExpressHelmet()'s generic defaults) so the CSP allowlist stays byte-for-byte
 * what the layout's asset includes (Prism/cdnjs, YouTube embeds, GoatCounter) actually need —
 * see layouts/Main.bxm in the source app for why each origin is there.
 */
app.use( ( req, res, next ) => {
	res.set( "Content-Security-Policy",
		"default-src 'self'; " &
		"script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com https://www.youtube.com; " &
		"script-src-elem 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com https://www.youtube.com; " &
		"style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; " &
		"img-src 'self' data: https://www.youtube.com https:; " &
		"font-src 'self' https://cdn.jsdelivr.net data:; " &
		"frame-src 'self' https://www.youtube.com https://player.vimeo.com https://clips.twitch.tv; " &
		"connect-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; " &
		"object-src 'none'; " &
		"base-uri 'self'; " &
		"form-action 'self';"
	)
	res.set( "X-Content-Type-Options", "nosniff" )
	res.set( "X-Frame-Options", "DENY" )
	res.set( "X-XSS-Protection", "1; mode=block" )
	// Browsers only honor HSTS over an actual HTTPS response, so this is a no-op (not a
	// dev-breaking one) when running plain HTTP locally.
	res.set( "Strict-Transport-Security", "max-age=15552000; includeSubDomains" )
	res.set( "Cross-Origin-Opener-Policy", "same-origin" )
	next()
} )

/**
 * Sessions — replaces the ColdBox client-scope `client.uid` cookie. 30-day maxAge matches the
 * source app's `this.clientTimeout = createTimespan(30,0,0,0)` in Application.bx.
 *
 * Instantiated directly (not via the boxExpressSession() BIF) so ws/Stomp.bx can read the same
 * in-memory session store by session id — app.ws() routes sit outside the app.use() middleware
 * chain entirely, so a WebSocket upgrade never runs Session middleware itself; STOMP CONNECT has
 * to look the cookie up against this exact store instance to identify the connecting user.
 */
sessionMiddleware = new "bxModules.boxexpress.models.middleware.Session"()
app.use( sessionMiddleware.session( {
	name: "dt_sid",
	maxAge: 60 * 60 * 24 * 30,
	// Only over plain HTTP in dev (no local TLS) — everywhere else the cookie should never be
	// sendable over an accidental/downgraded HTTP request, HSTS above notwithstanding.
	secure: Config.getEnv() != "development"
} ) )

/**
 * Realtime layer (Phase 6) — one shared STOMP broker for comment/vote/notification broadcasts
 * (ws/Broadcast.bx) and forum presence (ws/Presence.bx). See ws/Stomp.bx for the
 * authenticate()/authorize()/onSend() identity and presence-heartbeat model.
 *
 * stompBuilder.setPresence() runs after Presence exists (which itself needs the built broker, for
 * its own stomp.send() broadcasts — a real circular dependency, broken by wiring it in after the
 * fact) but still strictly before app.listen() below ever accepts a connection, so onSend() never
 * sees it unset for a real client.
 */
stompBuilder = new "ws.Stomp"( sessionMiddleware )
// getClusterManager() is a no-op ClusterManager (isManager() always true, no peer relay) unless
// modules.boxexpress's cluster.enabled is true in boxlang.json — passing it here unconditionally
// costs a single-instance deployment nothing.
stomp = stompBuilder.build( app.getClusterManager() )
app.ws( "/stomp", stomp.handler() )
AppContext.register( "Stomp", stomp )
AppContext.register( "Broadcast", new "ws.Broadcast"( stomp ) )
presence = new "ws.Presence"( stomp )
AppContext.register( "Presence", presence )
stompBuilder.setPresence( presence )

// Mounted before RequestContext's page-bootstrap middleware below — every /api/* route handler
// sends its own response directly (no next()), so a matching request never reaches that
// middleware or the page router at all. API auth is the X-Api-Key header, not the session.
apiRouter = boxExpressRouter()
new "routes.ApiRouter"().register( app, apiRouter )
app.use( "/api", apiRouter )

// CSRF protection for the session-authenticated page/action routes below — not /api/*, which
// is machine-to-machine (X-Api-Key header, no ambient browser credentials) and unaffected since
// requests there terminate inside apiRouter above without reaching this middleware. Mounted
// before RequestContext.bootstrap() so it can read req.csrfToken() into res.locals for every
// view (see lib/RequestContext.bx) — plain <form> posts (login/signup/submit) carry it as a
// hidden _csrf field, fetch()-driven actions (public/assets/js/actions.js) as an X-CSRF-Token
// header read from the <meta name="csrf-token"> tag Main.bxm renders.
app.use( boxExpressCsrf() )

// Replaces RequestService.bx::setup_request() + AppRouter.bx::preHandler()'s social-meta
// defaults — runs on every remaining (page) request, populating res.locals for the layout
// and views. Never reached by /api/* — see above.
RequestContext = AppContext.get( "RequestContext" )
app.use( ( req, res, next ) => {
	RequestContext.bootstrap( app, req, res )
	next()
} )

// Mounted at root, not "/public" — the source app's views reference root-relative paths
// (/assets/css/site.css, /favicon.svg) matching its own webroot layout; public/ here just
// holds those same files instead of the whole webroot.
//
// Two-tier Cache-Control: vendored web fonts never change without a manual replace, so they
// get a long-lived cache. Everything else (site.css, global.js, etc.) has no hashed/versioned
// filename yet — see the app.locals.assets note above — so a long cache there would mean a
// stale asset can outlive a deploy for up to the maxAge; a short one bounds that risk until a
// real build step adds cache-busted filenames.
app.use( "/assets/icons/fonts", boxExpressStatic( expandPath( "./public/assets/icons/fonts" ), { maxAge: 60 * 60 * 24 * 365 } ) )
app.use( boxExpressStatic( expandPath( "./public" ), { maxAge: 60 * 60 * 24 } ) )

actionsRouter = boxExpressRouter()
new "routes.ActionsRouter"().register( app, actionsRouter )
app.use( "/", actionsRouter )

pageRouter = boxExpressRouter()
new "routes.AppRouter"().register( app, pageRouter )
app.use( "/", pageRouter )

/**
 * Error handling — mirrors handlers/Main.bx::onException (generic message + 500, real detail
 * only in dev). boxExpress's own default error handling already does this too; this override
 * exists so the response shape/logging matches the source app deliberately rather than by
 * coincidence. Phase 3 should replace the JSON body with a rendered views/main/missing.bxm once
 * that view exists.
 */
app.use( ( err, req, res, next ) => {
	AppContext.get( "Logger" ).error( err.message )
	res.status( 500 )
	if ( Config.getEnv() == "development" ) {
		res.json( { error: true, message: err.message } )
	} else {
		res.json( { error: true, message: "Internal Server Error" } )
	}
} )

/**
 * Link-preview thumbnail cache (models/services/ImageProxyService.bx) has no other eviction —
 * nothing else in the app ever deletes from .cache/img-thumbs, so it grows forever without this.
 * Runs once a day; immediate: false since a fresh boot's cache is never big enough to be worth
 * pruning before the app has even served a request.
 */
app.schedule( 1000 * 60 * 60 * 24, ( job ) => {
	var deleted = AppContext.get( "ImageProxyService" ).pruneCache();
	if ( deleted > 0 ) {
		AppContext.get( "Logger" ).info( "[#job.name#] pruned #deleted# cached link-preview thumbnail(s)" );
	}
}, { name: "img-thumb-cache-prune" } )

/**
 * --port=NNNN on the command line overrides APP_PORT (Config.getPort()/.env) — lets a second (or
 * third...) instance of the same checkout run on its own port without a separate .env, e.g. for
 * exercising boxlang.json's modules.boxexpress.settings.cluster (see db/schema.sql's ClusterCache
 * table) locally:
 *
 *   boxlang --bx-config ./boxlang.json app.bxs --port=3001
 *
 * Each instance still needs its own CLUSTER_PEER_NAME (.env.example) — two instances sharing one
 * peer name would overwrite each other's heartbeat under the same ClusterCache row.
 */
cliPortArg = cliGetArgs().options.port ?: "";
listenPort = len( cliPortArg ) ? cliPortArg : Config.getPort();

app.listen( toNumeric( listenPort ), ( port ) => {
	println( "bxThreads listening on http://localhost:#port#" )
} )
