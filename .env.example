# Copy to .env and fill in real values. .env itself is gitignored — never commit it.

# --- Server -------------------------------------------------------------
APP_PORT=3000
APP_ENV=development

# Public site URL — used for canonical links, OG tags, sitemap generation.
SITE_URL=http://localhost:3000
SITE_NAME=bxThreads

# --- Admin API ------------------------------------------------------------
# Required by the /api/* admin endpoints (sent as the X-Api-Key header).
# Generate one with: uuidgen
API_KEY=

# --- MySQL datasource ("dismal" in boxlang.json) -------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dismal
DB_USER=root
DB_PASSWORD=

# --- Clustering (boxlang.json's modules.boxexpress.settings.cluster) -----
# Multi-instance peer discovery/STOMP relay, backed by the ClusterCache MySQL
# table (db/schema.sql) — see boxlang-express's plans/cluster-support.md.
# CLUSTER_PEER_NAME must be a real ws://host:port URL other instances can
# dial (ClusterPeer.bx connects to it directly + "/__cluster") — NOT a bare
# label. It has to match THIS instance's own --port (see app.bxs), so running
# a second local instance means overriding both together, e.g.:
#   CLUSTER_PEER_NAME=ws://localhost:3001 boxlang --bx-config ./boxlang.json app.bxs --port=3001
# Running a single instance? Leave this as-is — cluster.enabled stays
# functionally a no-op (isManager() always true) until a second instance
# actually appears.
CLUSTER_PEER_NAME=ws://localhost:3000
# Shared secret the /__cluster relay checks between peers. Generate one with:
# uuidgen — blank disables the check entirely, fine for a trusted network but
# not recommended once instances cross a public one.
CLUSTER_SECRET=
