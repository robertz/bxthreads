# Copy to .env and fill in real values. .env itself is gitignored — never commit it.

# --- Server -------------------------------------------------------------
APP_PORT=3000
APP_ENV=development

# Public site URL — used for canonical links, OG tags, sitemap generation.
SITE_URL=http://localhost:3000
SITE_NAME=bxThreads

# --- Admin API ------------------------------------------------------------
# Required by the /api/* admin endpoints (sent as the X-Api-Key header).
# Generate one with: uuidgen
API_KEY=

# --- MySQL datasource ("dismal" in boxlang.json) -------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dismal
DB_USER=root
DB_PASSWORD=
