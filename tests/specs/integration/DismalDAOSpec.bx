/**
 * Integration tests against the real local `dismal` MySQL database (same datasource app.bxs
 * itself uses, configured in boxlang.json/.env) — these are read-only queries, no rows are
 * written or deleted, so this is safe to run against a real dev database with real seed data.
 */
class extends="testbox.system.BaseSpec" {

	function beforeAll() {
		// DismalDAO resolves its `db` helper via the AppContext singleton (models/dao/DismalDAO.bx's
		// init()), which only gets populated by app.bxs's own boot sequence — not running here since
		// this spec never boots the actual server. Register just the one dependency this DAO needs.
		var appCtx = new "lib.AppContext"();
		if ( !appCtx.has( "Sql" ) ) {
			appCtx.register( "Sql", new "lib.Sql"() );
		}
		variables.dao = new "models.dao.DismalDAO"();
	}

	function run() {
		describe( "DismalDAO", function() {

			describe( "getPosts()", function() {
				it( "returns an array of post structs shaped for FeedItemRenderer", function() {
					var posts = variables.dao.getPosts( { limit: 5 } );
					expect( posts ).toBeTypeOf( "array" );
					if ( posts.len() ) {
						var p = posts[ 1 ];
						expect( p ).toHaveKey( "id_short" );
						expect( p ).toHaveKey( "title" );
						expect( p ).toHaveKey( "forum" );
						expect( p ).toHaveKey( "vote_score" );
						expect( p ).toHaveKey( "comment_count" );
					}
				} );

				it( "honors the limit filter", function() {
					var posts = variables.dao.getPosts( { limit: 3 } );
					expect( posts.len() ).toBeLTE( 3 );
				} );
			} );

			describe( "getPosts() FULLTEXT search (matchQuery)", function() {
				it( "finds posts containing a real word via the ft_posts_search index", function() {
					var posts = variables.dao.getPosts( { matchQuery: "ColdFusion", limit: 50 } );
					expect( posts.len() ).toBeGT( 0 );
					for ( var p in posts ) {
						var hay = lCase( p.title & " " & p.body );
						expect( hay.find( "coldfusion" ) ).toBeGT( 0 );
					}
				} );

				it( "returns nothing for a nonsense query instead of falling back to the unfiltered feed", function() {
					var posts = variables.dao.getPosts( { matchQuery: "zzznonexistentsearchtermxyz", limit: 50 } );
					expect( posts.len() ).toBe( 0 );
				} );

				it( "returns nothing (not everything) when the query is only boolean-mode operator characters", function() {
					var posts = variables.dao.getPosts( { matchQuery: "+++---", limit: 50 } );
					expect( posts.len() ).toBe( 0 );
				} );

				it( "paginates search results via offset with no duplicate rows across pages", function() {
					var pageOne = variables.dao.getPosts( { matchQuery: "and", limit: 5, offset: 0 } );
					var pageTwo = variables.dao.getPosts( { matchQuery: "and", limit: 5, offset: 5 } );
					if ( pageOne.len() < 5 ) return;
					var idsOne = pageOne.map( ( p ) => p.id_short );
					var idsTwo = pageTwo.map( ( p ) => p.id_short );
					for ( var id in idsTwo ) {
						expect( idsOne ).notToInclude( id );
					}
				} );
			} );

			describe( "getTopViewedPosts() offset pagination", function() {
				it( "returns disjoint pages with no overlap, matching the infinite-scroll contract", function() {
					var pageOne = variables.dao.getTopViewedPosts( { limit: 5, offset: 0 } );
					var pageTwo = variables.dao.getTopViewedPosts( { limit: 5, offset: 5 } );

					if ( pageOne.len() < 5 ) {
						// Not enough seed data in the last 24h to meaningfully test pagination —
						// still a legitimate outcome, just nothing further to assert here.
						return;
					}

					var idsOne = pageOne.map( ( p ) => p.id_short );
					var idsTwo = pageTwo.map( ( p ) => p.id_short );
					for ( var id in idsTwo ) {
						expect( idsOne ).notToInclude( id );
					}
				} );
			} );

		} );
	}

}
