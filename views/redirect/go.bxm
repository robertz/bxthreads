<bx:output>
<meta http-equiv="refresh" content="0;url=#encodeForHTMLAttribute(data.targetUrl)#">
<div class="container mb-5">

	<div class="row">
		<div class="col-12 col-lg-6 offset-lg-3 p-2">

			<div class="card" style="border-radius: 4px; border: 1px solid var(--ui-border-subtle); background-color: var(--ui-surface-1);">
				<div class="card-body text-center py-5">
					<div class="fw-bold h5 mb-3" style="color: var(--text-secondary);">You are leaving #encodeForHTML(data.meta.author)#</div>
					<p style="font-size: 0.9rem; color: var(--text-muted);">You are being redirected to:</p>
					<p class="mb-4" style="font-size: 0.85rem; word-break: break-all; color: var(--post-anchor);">#encodeForHTML(data.targetUrl)#</p>
					<a href="#encodeForHTMLAttribute(data.targetUrl)#" rel="noopener nofollow ugc" class="login-btn--secondary" style="display: inline-block; padding: 8px 24px; border-radius: 999px; font-size: 0.85rem; font-weight: 600; text-decoration: none;">Continue to site</a>
				</div>
			</div>

		</div>
	</div>

</div>
</bx:output>
