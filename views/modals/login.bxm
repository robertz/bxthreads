<bx:output>

	<bx:set flashMode = ( data.flash.keyExists("mode") ? data.flash.mode : "login" )>
	<bx:set flashError = ( data.flash.keyExists("error") ? data.flash.error : "" )>
	<bx:set flashUsername = ( data.flash.keyExists("username") ? data.flash.username : "" )>
	<bx:set flashEmail = ( data.flash.keyExists("email") ? data.flash.email : "" )>

	<!---
		data-auto-open: a failed login/signup POST redirects back to the page the user submitted
		from (see routes/AppRouter.bx's safeRedirectTarget()) rather than always to home — this
		modal only ever gets opened via an explicit click on "Join / Sign In" otherwise, so without
		this, a login/signup error set on the flash would render into this markup but never
		actually be shown: the page just reloads looking like nothing happened, "swallowing" the
		error. The tiny inline script right after this partial's include (views/layouts/Main.bxm)
		opens the modal on page load when this attribute is present.
	--->
	<div id="login-modal" class="modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="login-modal-title" #len( flashError ) ? "data-auto-open" : ""#>
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content bg-dark">
				<div class="modal-body">
					<bx:set suggestedUsername = new "lib.AppContext"().get("Admin").generateUsername()>

					<h5 id="login-modal-title" class="login-title mb-4" data-login-heading="login" style="#flashMode == 'login' ? '' : 'display:none;'#">Sign In</h5>
					<h5 class="login-title mb-4" data-login-heading="signup" style="#flashMode == 'signup' ? '' : 'display:none;'#">Create Account</h5>

					<!---
						Always rendered (not just when a flash error exists) so the JS-driven submit
						path (public/assets/js/actions.js's handleAuthFormSubmit()) has a stable element
						to show/update on a failed fetch instead of creating one — a failed submit there
						never navigates at all, so this is the ONLY way the user ever sees that error.
						Still starts hidden unless a flash error was actually set (the no-JS plain-form
						fallback path, or the very first render of a fresh page).
					--->
					<div class="login-alert login-alert--error mb-3" role="alert" data-login-alert style="#len(flashError) ? '' : 'display:none;'#">
						<i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
						<span data-login-alert-text>#encodeForHTML(flashError)#</span>
					</div>

					<form method="post" action="/login" data-login-panel="login" style="#flashMode == 'login' ? '' : 'display:none;'#">
						<input type="hidden" name="_csrf" value="#encodeForHTMLAttribute( data.csrfToken ?: '' )#">
						<input type="hidden" name="redirect_to" value="#encodeForHTMLAttribute( data.currentPath ?: '/' )#">
						<div class="login-field mb-4">
							<label class="login-label" for="login-user">Username or email</label>
							<input id="login-user" class="login-input" type="text" name="user" required autocomplete="username" placeholder="User name or email" value="#encodeForHTMLAttribute(flashUsername)#">
						</div>
						<div class="login-field mb-4">
							<label class="login-label" for="login-password">Password</label>
							<input id="login-password" class="login-input" type="password" name="password" required autocomplete="current-password" placeholder="Password">
						</div>
						<div class="login-switch mb-2">
							New here?
							<button type="button" class="login-link" data-login-tab="signup">Create Account</button>
						</div>
						<div class="login-actions">
							<button type="button" class="login-btn login-btn--secondary" onclick="DTModal.close('login-modal')">Close</button>
							<button type="submit" class="login-btn login-btn--primary">Sign In</button>
						</div>
					</form>

					<form method="post" action="/signup" data-login-panel="signup" style="#flashMode == 'signup' ? '' : 'display:none;'#">
						<input type="hidden" name="_csrf" value="#encodeForHTMLAttribute( data.csrfToken ?: '' )#">
						<input type="hidden" name="redirect_to" value="#encodeForHTMLAttribute( data.currentPath ?: '/' )#">
						<div class="login-field mb-4">
							<label class="login-label" for="signup-username">Username</label>
							<input id="signup-username" class="login-input" type="text" name="username" required autocomplete="username" placeholder="User name" value="#encodeForHTMLAttribute( len(flashUsername) ? flashUsername : suggestedUsername )#">
						</div>
						<div class="login-field mb-4">
							<label class="login-label" for="signup-email">Email</label>
							<input id="signup-email" class="login-input" type="email" name="email" required autocomplete="email" placeholder="Email" value="#encodeForHTMLAttribute(flashEmail)#">
						</div>
						<div class="login-field mb-4">
							<label class="login-label" for="signup-password">Password</label>
							<input id="signup-password" class="login-input" type="password" name="password" required autocomplete="new-password" minlength="8" placeholder="Password (8+ characters)">
						</div>
						<div class="login-switch mb-2">
							Already have an account?
							<button type="button" class="login-link" data-login-tab="login">Sign In</button>
						</div>
						<div class="login-actions">
							<button type="button" class="login-btn login-btn--secondary" onclick="DTModal.close('login-modal')">Close</button>
							<button type="submit" class="login-btn login-btn--primary">Create Account</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>

	<script>
		(function () {
			document.querySelectorAll('[data-login-tab]').forEach(function (tab) {
				tab.addEventListener('click', function () {
					var mode = tab.getAttribute('data-login-tab');
					document.querySelectorAll('[data-login-panel]').forEach(function (panel) {
						panel.style.display = (panel.getAttribute('data-login-panel') === mode) ? '' : 'none';
					});
					document.querySelectorAll('[data-login-heading]').forEach(function (h) {
						h.style.display = (h.getAttribute('data-login-heading') === mode) ? '' : 'none';
					});
					var alertEl = document.querySelector('[data-login-alert]');
					if (alertEl) alertEl.style.display = 'none';
				});
			});
		})();
	</script>

</bx:output>
